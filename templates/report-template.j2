<h3>里程碑</h3>
{{ timeline(milestones) }}
{%- endif %}

{%- set risks = plan.get('top_risks', []) %}
{%- if risks %}
<h3>Top 技术风险</h3>
{%- for r in risks %}
  {{ callout(r.get('risk',''), '<p><strong>影响阶段</strong>：' ~ r.get('affected_phase','') ~ '</p><p><strong>缓解措施</strong>：' ~ r.get('mitigation','') ~ '</p>', 'danger') }}
{%- endfor %}
{%- endif %}

{%- set res = plan.get('resource_suggestions', '') %}
{%- if res %}
<h3>资源建议</h3>
<p>{{ res }}</p>
{%- endif %}

