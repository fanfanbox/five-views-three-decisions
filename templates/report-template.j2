{# ============================================================ #}
<h2 id="s9">九、定策略：差异化制胜点</h2>
{# ============================================================ #}
{%- set rec = strategy.get('recommended_strategy', '') %}
{%- set rationale = strategy.get('rationale', '') %}
{%- if rec %}
{{ callout('推荐策略', '<p><strong>' ~ rec ~ '</strong><p style="margin-top:8px;color:#1e40af;">' ~ rationale ~ '</p>', 'info') }}
{%- endif %}

{%- set edges = strategy.get('differentiation_edges', []) %}
{%- if edges %}
<h3>差异化支撑</h3>
<ul>
{%- for e in edges %}
  <li>{{ e }}</li>
{%- endfor %}
</ul>
{%- endif %}

{%- set rejected = strategy.get('rejected_strategies', []) %}
{%- if rejected %}
<h3>已排除策略</h3>
<table>
  <tr><th>策略</th><th>排除原因</th></tr>
{%- for r in rejected %}
  <tr><td>{{ r.get('strategy', '') }}</td><td>{{ r.get('reason', '') }}</td></tr>
{%- endfor %}
</table>
{%- endif %}

{# ============================================================ #}
<h2 id="s10">十、定计划：研发路线图</h2>
{# ============================================================ #}
{%- set milestones = plan.get('milestones', []) %}
