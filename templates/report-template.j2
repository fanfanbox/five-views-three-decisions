{# ============================================================ #}
{# 五看三定战略洞察报告 — Jinja2 HTML Template               #}
{# ============================================================ #}
{%- macro badge(text, level='mid') -%}
<span class="badge {{ level }}">{{ text }}</span>
{%- endmacro %}

{%- macro callout(title, body, type='info') -%}
<div class="callout {{ type }}">
  <div class="title">{{ title }}</div>
  {{ body }}
</div>
{%- endmacro %}

{%- macro metric_card(value, label, class='') -%}
<div class="metric-card{{ ' ' + class if class else '' }}">
  <div class="value">{{ value }}</div>
  <div class="label">{{ label }}</div>
</div>
{%- endmacro %}

{%- macro maturity_meter(active) -%}
{%- set stages = ['导入期','爆发期','成熟期','衰退期'] -%}
{%- set colors = ['#d1d5db','#9ca3af','#2563eb','#d1d5db'] -%}
{%- set active_idx = stages.index(active) if active in stages else -1 -%}
<div class="maturity-meter">
{%- for s in stages %}
  <div class="maturity-seg{{ ' active' if loop.index0 == active_idx else '' }}" style="background:{{ colors[loop.index0] if loop.index0 != active_idx else '#2563eb' }}; color:{{ '#fff' if loop.index0 == active_idx else '#475569' }};">{{ s }}</div>
{%- endfor %}
</div>
{%- endmacro %}

{%- macro bar_chart(rows) -%}
<div class="bar-chart">
{%- for r in rows %}
  <div class="bar-row">
    <div class="bar-label">{{ r.label }}</div>
    <div class="bar-track">
      <div class="bar-fill" style="width:{{ r.pct }}%; background:{{ r.color or '#2563eb' }};">{% if r.pct >= 25 %}{{ r.text or (r.pct|string + '%') }}{% endif %}</div>
    </div>
    {%- if r.value %}<div class="bar-value">{{ r.value }}</div>{%- endif %}
  </div>
{%- endfor %}
</div>
{%- endmacro %}

{%- macro competitor_cards(players) -%}
<div class="comp-grid">
{%- for p in players %}
  {%- set type_class = {'巨头': '', '初创': 'startup', '跨界': 'cross'}.get(p.type, '') %}
  {%- set params = p.get('technical_params', {}) %}
  {%- set param_str = params.items()|list|map('join', '=')|join('<br>') %}
  <div class="comp-card">
    <div class="name">{{ p.name }}{% if p.type %}<span class="tag{{ ' ' + type_class if type_class else '' }}">{{ p.type }}</span>{% endif %}</div>
    <div class="detail">
      {%- if p.region %}🌍 {{ p.region }}<br>{% endif %}
      {%- if p.target_market %}<strong>目标</strong>：{{ p.target_market }}<br>{% endif %}
      {%- if p.price_range %}<strong>价格</strong>：{{ p.price_range }}<br>{% endif %}
      {%- if p.annual_production %}<strong>产量</strong>：{{ p.annual_production }}<br>{% endif %}
      {%- if p.annual_revenue %}<strong>营收</strong>：{{ p.annual_revenue }}<br>{% endif %}
      {%- if p.key_customers %}<strong>客户</strong>：{{ p.key_customers|join('、') }}<br>{% endif %}
      {%- if param_str %}<strong>参数</strong>：{{ param_str }}{% endif %}
    </div>
  </div>
{%- endfor %}
</div>
{%- endmacro %}

{%- macro timeline(items) -%}
<div class="timeline">
{%- for item in items %}
  <div class="timeline-item">
    <div class="phase">{{ item.phase }}{% if item.timeline %}<span class="period">{{ item.timeline }}</span>{% endif %}</div>
    {%- if item.deliverables %}<div class="detail">{{ item.deliverables }}</div>{% endif %}
  </div>
{%- endfor %}
</div>
{%- endmacro %}

{%- macro ref_list(refs) -%}
<div class="ref-list">
{%- for r in refs %}
  <div class="ref-item">
    <span class="cite-text">{{ r.title }}</span>
    {%- if r.domain %}<span class="tag-domain">{{ r.domain }}</span>{% endif %}
    {%- if r.url %}<a class="source" href="{{ r.url }}" target="_blank">{{ r.url }}</a>{% endif %}
  </div>
{%- endfor %}
</div>
{%- endmacro %}

{%- macro line_chart(series, width=500, height=180) -%}
{%- if series and series|length > 1 %}
{%- set max_val = series|map(attribute='value')|max %}
{%- set min_val = series|map(attribute='value')|min %}
{%- set value_range = max_val - min_val if max_val > min_val else 1 %}
{%- set pl_x = 45 %}{% set pl_y = 20 %}{% set pl_w = width - pl_x - 15 %}{% set pl_h = height - pl_y - 30 %}
{%- set n = series|length %}
{%- set ns = namespace(polyline='', polygon='') %}
{%- for d in series %}
  {%- set x = pl_x + (loop.index0 * pl_w / (n - 1)) %}
  {%- set y = pl_y + pl_h - ((d.value - min_val) / value_range * pl_h) %}
  {%- set pt = x|string ~ ',' ~ y|string %}
  {%- set ns.polyline = ns.polyline ~ ' ' ~ pt %}
  {%- set ns.polygon = ns.polygon ~ ' ' ~ pt %}
{%- endfor %}
{%- set ns.polygon = ns.polygon ~ ' ' ~ (pl_x + pl_w)|string ~ ',' ~ (pl_y + pl_h)|string ~ ' ' ~ pl_x|string ~ ',' ~ (pl_y + pl_h)|string %}
<div class="line-chart">
  <svg viewBox="0 0 {{ width }} {{ height }}" style="width:100%;height:{{ height }}px;">
    <defs><linearGradient id="lg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3b82f6" stop-opacity="0.15"/><stop offset="100%" stop-color="#3b82f6" stop-opacity="0.01"/></linearGradient></defs>
    <line x1="{{ pl_x }}" y1="{{ pl_y }}" x2="{{ pl_x }}" y2="{{ pl_y + pl_h }}" stroke="#cbd5e1" stroke-width="1"/>
    <line x1="{{ pl_x }}" y1="{{ pl_y + pl_h }}" x2="{{ pl_x + pl_w }}" y2="{{ pl_y + pl_h }}" stroke="#cbd5e1" stroke-width="1"/>
    {%- for i in range(5) %}
      {%- set gy = pl_y + (pl_h * i / 4) %}
      <line x1="{{ pl_x }}" y1="{{ gy }}" x2="{{ pl_x + pl_w }}" y2="{{ gy }}" stroke="#f1f5f9" stroke-width="1"/>
      <text x="{{ pl_x - 8 }}" y="{{ gy + 4 }}" text-anchor="end" fill="#94a3b8" font-size="10">{{ (max_val - (value_range * i / 4))|round|int }}</text>
    {%- endfor %}
    <polygon points="{{ ns.polygon }}" fill="url(#lg)"/>
    <polyline points="{{ ns.polyline }}" fill="none" stroke="#2563eb" stroke-width="2" stroke-linejoin="round"/>
    {%- for d in series %}
      {%- set x = pl_x + (loop.index0 * pl_w / (n - 1)) %}
      {%- set y = pl_y + pl_h - ((d.value - min_val) / value_range * pl_h) %}
      <circle cx="{{ x }}" cy="{{ y }}" r="4" fill="#fff" stroke="#2563eb" stroke-width="2"/>
      <text x="{{ x }}" y="{{ pl_y + pl_h + 18 }}" text-anchor="middle" fill="#64748b" font-size="10">{{ d.label }}</text>
      <text x="{{ x }}" y="{{ y - 10 }}" text-anchor="middle" fill="#1e293b" font-size="11" font-weight="600">{{ d.value }}</text>
    {%- endfor %}
  </svg>
</div>
{%- endif %}
{%- endmacro %}
{# ============================================================ #}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>五看三定战略洞察报告：{{ product_direction }}</title>
<style>
{%- include 'report-style.css' %}
</style>
</head>
<body>
<div class="report">

<!-- 页头 -->
<div class="header">
  <h1>五看三定战略洞察报告</h1>
  <div class="meta">{{ product_direction }} · {{ date_str }}</div>
  <div class="author">✍️ Dr.-ING Jian WANG · 五看三定AI战略分析引擎 v1.0</div>
</div>

<!-- 目录 -->
<div class="toc">
  <a href="#s1">一、摘要</a><span class="toc-sep">|</span>
  <a href="#s2">二、看趋势</a><span class="toc-sep">|</span>
  <a href="#s3">三、看对手</a><span class="toc-sep">|</span>
  <a href="#s4">四、看客户</a><span class="toc-sep">|</span>
  <a href="#s5">五、看自己</a><span class="toc-sep">|</span>
  <a href="#s6">六、看机会</a><span class="toc-sep">|</span>
  <a href="#s7">七、交叉验证</a><span class="toc-sep">|</span>
  <a href="#s8">八、定目标</a><span class="toc-sep">|</span>
  <a href="#s9">九、定策略</a><span class="toc-sep">|</span>
  <a href="#s10">十、定计划</a><span class="toc-sep">|</span>
  <a href="#s11">十一、附录</a>
</div>

{# ---- 关键指标卡片 ---- #}
{%- set gap_count = self_data.get('capability_gap_matrix', [])|length %}
{%- set t1 = opp.get('market_growth_rate', '') %}
{%- set first_opp = opp.get('opportunity_funnel', [])[0] if opp.get('opportunity_funnel', []) else {} %}
{%- set tam_cn_val = (first_opp.get('tam_china', {}).get('value', '')|string ~ (first_opp.get('tam_china', {}).get('unit', '') or '')) if first_opp.get('tam_china', {}).get('value') else '—' %}
{%- set tam_gl_val = (first_opp.get('tam_global', {}).get('value', '')|string ~ (first_opp.get('tam_global', {}).get('unit', '') or '')) if first_opp.get('tam_global', {}).get('value') else '—' %}
{%- set ttm = goal.get('business_targets', {}).get('time_to_market', '—') %}
<div class="metrics">
  {% if t1 %}<a href="#s3" class="metric-link">{{ metric_card(t1|strip_parens, '市场增速', '') }}<small style="display:block;color:#94a3b8;font-size:10px;line-height:1.2;margin-top:2px;">来源：{{ t1|extract_parens }}</small></a>{% endif %}
  {% if tam_cn_val != '—' %}<a href="#s6" class="metric-link">{{ metric_card(tam_cn_val, '🇨🇳 中国TAM', '') }}</a>{% endif %}
  {% if tam_gl_val != '—' %}<a href="#s6" class="metric-link">{{ metric_card(tam_gl_val, '🌍 全球TAM', 'green') }}</a>{% endif %}
  {% if ttm != '—' %}<a href="#s11" class="metric-link">{{ metric_card(ttm|strip_parens, '上市周期', 'orange') }}</a>{% endif %}
  {% if gap_count > 0 %}<a href="#gap-matrix" class="metric-link">{{ metric_card(gap_count|string + '项', '关键差距', 'purple') }}</a>{% endif %}
</div>

{# ============================================================ #}
<h2 id="s1">一、执行摘要</h2>
{# ============================================================ #}
{%- set insights = synthesis.get('cross_module_insights', []) %}
{%- set top_opp = synthesis.get('prioritized_opportunities', [])[0] if synthesis.get('prioritized_opportunities', []) else {} %}
{%- set top_risk = plan.get('top_risks', [])[0] if plan.get('top_risks', []) else {} %}
{%- set rec_strat = strategy.get('recommended_strategy', '') %}

{%- if insights %}
<p><strong>核心发现</strong>：{{ insights[0] if insights[0] is string else insights[0].get('insight', insights[0]) }}</p>
{%- endif %}

{%- if top_opp or rec_strat or top_risk %}
<div class="metrics" style="margin-bottom:16px;">
  {%- if top_opp %}
    {{ metric_card('🎯 ' + (top_opp.get('opportunity','')|strip_parens|truncate(20)), '首选机会', 'green') }}
  {%- endif %}
  {%- if rec_strat %}
    {{ metric_card(rec_strat|strip_parens|truncate(10), '推荐策略', 'teal') }}
  {%- endif %}
  {%- if top_risk %}
    {{ metric_card('⚠️ ' + (top_risk.get('risk','')|strip_parens|truncate(16)), '首要风险', 'orange') }}
  {%- endif %}
</div>
{%- endif %}

<p>本报告对「{{ product_direction }}」进行了五看三定全维度战略分析，基于公开网络信息从技术趋势、竞争格局、客户需求、自身能力、市场机会五个维度出发，经交叉验证后形成目标-策略-计划三层决策建议。</p>

{%- set refs = references or [] %}

{# ============================================================ #}
<h2 id="s2">二、看趋势：行业与技术风向标</h2>
{# ============================================================ #}
{%- set ms_trend = trend.get('market_split', {}) %}
{%- if ms_trend.get('china') or ms_trend.get('global') %}
<h4>市场分拆：中国 vs 全球</h4>
<div style="display:flex;gap:16px;margin:12px 0;">
  {%- if ms_trend.get('china') %}
  <div style="flex:1;background:#f0fdf4;border-radius:8px;padding:12px;border-left:4px solid #16a34a;">
    <h5 style="margin:0 0 8px;color:#16a34a;">🇨🇳 中国</h5>
    {% if ms_trend.china.outlook %}<p style="font-size:13px;margin:4px 0;"><strong>概述</strong>：{{ ms_trend.china.outlook }}</p>{% endif %}
    {% if ms_trend.china.key_demand %}<p style="font-size:13px;margin:4px 0;"><strong>需求</strong>：{{ ms_trend.china.key_demand }}</p>{% endif %}
    {% if ms_trend.china.policy_drivers %}<p style="font-size:13px;margin:4px 0;"><strong>政策</strong>：{{ ms_trend.china.policy_drivers }}</p>{% endif %}
  </div>
  {%- endif %}
  {%- if ms_trend.get('global') %}
  <div style="flex:1;background:#eff6ff;border-radius:8px;padding:12px;border-left:4px solid #2563eb;">
    <h5 style="margin:0 0 8px;color:#2563eb;">🌍 全球</h5>
    {% if ms_trend.global.outlook %}<p style="font-size:13px;margin:4px 0;"><strong>概述</strong>：{{ ms_trend.global.outlook }}</p>{% endif %}
    {% if ms_trend.global.key_demand %}<p style="font-size:13px;margin:4px 0;"><strong>需求</strong>：{{ ms_trend.global.key_demand }}</p>{% endif %}
    {% if ms_trend.global.policy_drivers %}<p style="font-size:13px;margin:4px 0;"><strong>政策</strong>：{{ ms_trend.global.policy_drivers }}</p>{% endif %}
  </div>
  {%- endif %}
</div>
{%- endif %}
{%- set lifecycle = trend.get('technology_lifecycle', '') %}

{%- if lifecycle %}
<h3>技术生命周期</h3>
{{ maturity_meter(lifecycle) }}
<p>技术处于 <strong>{{ badge(lifecycle, {'导入期':'low','爆发期':'mid','成熟期':'high','衰退期':'low'}.get(lifecycle,'mid')) }}</strong> 阶段。</p>
{%- endif %}

{%- if trend.get('lifecycle_evidence', []) %}
<h4>判断依据</h4>
<ul>
{%- for e in trend.get('lifecycle_evidence', []) %}
  <li>{{ e }}</li>
{%- endfor %}
</ul>
{%- endif %}

{%- if trend.get('key_trends', []) %}
<h3>关键趋势</h3>
{%- set trend_colors = ['#2563eb','#3b82f6','#60a5fa','#93c5fd','#bfdbfe'] %}
{%- set trend_rows = [] %}
{%- for t in trend.get('key_trends', []) %}
  {%- set conf_val = {'高': 90, '中': 70, '低': 40}.get(t.get('confidence',''), 60) %}
  {%- set _ = trend_rows.append({'label': t.get('trend','')|truncate(18), 'pct': conf_val, 'text': t.get('confidence',''), 'value': '置信度 ' ~ t.get('confidence',''), 'color': trend_colors[loop.index0 % 5]}) %}
{%- endfor %}
<div class="flex-trend">
  <div class="flex-text">
    <p><strong>核心判断</strong>：技术端呈现以下关键趋势，直接影响产品定义与技术选型方向。</p>
    <ul>
    {%- for t in trend.get('key_trends', []) %}
      <li><strong>{{ t.get('trend','') }}</strong>（{{ t.get('confidence','') }}置信度）</li>
    {%- endfor %}
    </ul>
  </div>
  <div class="flex-chart">
    {{ bar_chart(trend_rows) }}
  </div>
</div>
{%- endif %}

{%- if trend.get('policy_landscape', []) %}
<h3>政策环境一览</h3>
<table>
  <tr><th style="width:25%">区域</th><th>政策/法规</th><th>影响</th></tr>
{%- for p in trend.get('policy_landscape', []) %}
  <tr><td>{{ p.get('region', '') }}</td><td>{{ p.get('policy', '') }}</td><td>{{ p.get('impact', '') }}</td></tr>
{%- endfor %}
</table>
{%- endif %}

{%- if trend.get('standards', []) %}
<h3>标准体系</h3>
<table>
  <tr><th>标准</th><th>状态</th><th>关联度</th></tr>
{%- for s in trend.get('standards', []) %}
  <tr><td>{{ s.get('standard', '') }}</td><td>{{ s.get('status', '') }}</td><td>{{ s.get('relevance', '') }}</td></tr>
{%- endfor %}
</table>
{%- endif %}

{%- set roadmap = trend.get('technology_roadmap', []) %}
{%- if roadmap %}
<h3>技术路线代际对比</h3>
<table>
  <tr><th>阶段</th><th>时间范围</th><th>关键技术</th><th>成熟度预测</th><th>备注</th></tr>
{%- for r in roadmap %}
  <tr>
    <td><strong>{{ r.get('phase', '') or r.get('generation', '') }}</strong></td>
    <td>{{ r.get('timeline_estimate', '') or r.get('timeframe', '') }}</td>
    <td>{%- set kt = r.get('key_technologies', []) or r.get('key_features', []) %}{{ kt if kt is string else kt|join('、') }}</td>
    <td>{{ r.get('maturity_forecast', '') or r.get('expected_improvement', '') }}</td>
    <td>{{ r.get('notes', '') or r.get('maturity', '') }}</td>
  </tr>
{%- endfor %}
</table>
{%- endif %}

{%- set demand_trends = trend.get('demand_volume_trends', []) %}
{%- if demand_trends %}
<h3>需求总量变化趋势</h3>
<table>
  <tr><th>时期</th><th>需求量</th><th>增长率</th><th>驱动因素</th></tr>
{%- for d in demand_trends %}
  <tr>
    <td>{{ d.get('year_or_period', '') }}</td>
    <td>{{ d.get('volume_numeric', '') or d.get('volume', '') }}{{ d.get('unit', '') }}</td>
    <td>{{ d.get('growth_rate', '') }}</td>
    <td>{{ d.get('key_driver', '') or d.get('driver', '') }}</td>
  </tr>
{%- endfor %}
</table>
{# 折线图：基于 volume_numeric 绘制 #}
{%- set line_data = [] %}
{%- for d in demand_trends if d.get('volume_numeric') %}
  {%- set _ = line_data.append({'label': d.get('year_or_period', ''), 'value': d.get('volume_numeric')}) %}
{%- endfor %}
{%- if line_data|length > 1 %}
{{ line_chart(line_data) }}
{%- endif %}
{%- endif %}

{%- set reg_demand = trend.get('regional_demand', []) %}
{%- if reg_demand %}
<h4>分地区需求分布</h4>
<div class="region-demand">
<table>
  <tr><th>地区</th><th>需求量（{{ (reg_demand[0] or {}).get('unit', '') }}）</th><th>占比</th><th>备注</th></tr>
  {#- Calculate total_reg numeric sum #}
  {%- set total_reg = namespace(val=0) %}
  {%- set total_reg_unit = '' %}
  {%- for r in reg_demand %}
  {%- set rv = r.get('demand_value') or r.get('value', 0) %}
  {%- set total_reg.val = total_reg.val + (rv|numval) %}
  {%- if r.get('unit') %}{%- set total_reg_unit = r.get('unit') %}{%- endif %}
  {%- endfor %}
  {%- set total_reg = total_reg.val %}
  {%- for r in reg_demand %}
  {%- set r_val = r.get('demand_value') or r.get('value', '') %}
  <tr>
    <td><strong>{{ r.get('region', '') }}</strong></td>
    <td>{{ r_val }}{{ r.get('unit', '') }}</td>
    <td>{{ (r_val|numval / total_reg * 100)|round|int if total_reg > 0 else '—' }}%</td>
    <td>{{ r.get('note', '') }}</td>
  </tr>
  {%- endfor %}
  <tr style="font-weight:700;background:#f1f5f9;"><td>合计</td><td>{{ total_reg }}{{ total_reg_unit }}</td><td>100%</td><td>数据年份：{{ (reg_demand[0] or {}).get('year', '') }}</td></tr>
</table>
</div>
{%- endif %}

{%- set pt = trend.get('price_trends', {}) %}
{%- if pt %}
<h3>价格分布与变化</h3>
<table>
  <tr><th>档次</th><th>价格</th></tr>
  <tr><td>入门级</td><td>{{ pt.get('entry_level_price', '—') }}</td></tr>
  <tr><td>中端</td><td>{{ pt.get('mid_range_price', '—') }}</td></tr>
  <tr><td>高端</td><td>{{ pt.get('high_end_price', '—') }}</td></tr>
  <tr><td>单位</td><td>{{ pt.get('unit', '—') }}</td></tr>
  <tr><td>同比变化</td><td>{{ pt.get('year_over_year_change', '—') }}{% if pt.get('year_over_year_change') and '%' not in pt.get('year_over_year_change') %}%{% endif %}</td></tr>
</table>
{%- if pt.get('trend_description') %}<p><em>{{ pt.get('trend_description') }}</em></p>{% endif %}
{%- endif %}

{# ============================================================ #}
{%- set has_comp_content = comp.get('top_players') or comp.get('competitive_landscape_summary') or comp.get('market_split', {}).get('china') or comp.get('market_split', {}).get('global') or comp.get('pricing_overview') or comp.get('market_share_distribution') or comp.get('emerging_threats') -%}
{%- if has_comp_content %}
<h2 id="s3">三、看对手：竞争格局全景图</h2>
{# ============================================================ #}
{%- set ms_comp = comp.get('market_split', {}) %}
{%- if ms_comp.get('china') or ms_comp.get('global') %}
<h4>市场分拆：中国 vs 全球</h4>
<div style="display:flex;gap:16px;margin:12px 0;">
  {%- if ms_comp.get('china') %}
  <div style="flex:1;background:#f0fdf4;border-radius:8px;padding:12px;border-left:4px solid #16a34a;">
    <h5 style="margin:0 0 8px;color:#16a34a;">🇨🇳 中国</h5>
    {% if ms_comp.china.landscape_summary %}<p style="font-size:13px;margin:4px 0;"><strong>竞争格局</strong>：{{ ms_comp.china.landscape_summary }}</p>{% endif %}
